{
    "manifest_version": 3,
    "name": "IaC Module Linker",
    "description": "Converts Terraform and OpenTofu module sources into clickable links that take you to the module definition. Works on GitHub.",
    "permissions": ["tabs", "scripting", "activeTab", "storage"],
    "host_permissions": [
        "https://github.com/*",
        "https://registry.terraform.io/*",
        "https://registry.opentofu.org/*"
    ],
    "version": "0.0.0.17",
    "minimum_chrome_version": "112",
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/?*"],
            "js": ["contentscript.js"],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "backgroundscript.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "96": "icons/icon96.png",
        "128": "icons/icon128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}
