{
    "name": "iac-module-linker-e2e",
    "private": true,
    "description": "End to end tests that load the built extension in Chromium.",
    "scripts": {
        "e2e": "playwright test --project=e2e-github --project=e2e-gitlab",
        "benchmark": "IAC_BUILD=dist-bench playwright test --project=benchmark",
        "e2e:headed": "playwright test --project=e2e-github --project=e2e-gitlab --headed",
        "e2e:report": "playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0"
    }
}
