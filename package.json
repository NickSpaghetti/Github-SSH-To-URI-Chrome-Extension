{
    "name": "iac-module-linker",
    "version": "1.0.0",
    "description": "Chrome extension that converts Terraform module sources into clickable links to the module definition page.",
    "main": "index.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite build",
        "build:bench": "IAC_READABLE=1 vite build",
        "test": "jest",
        "lint": "eslint .",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json --output human",
        "lint:errors": "eslint . --quiet",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit:prod": "pnpm audit --prod",
        "audit:dev": "pnpm audit --dev",
        "prepare": "husky",
        "e2e": "pnpm --dir tests/e2e e2e"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.tsx": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NickSpaghetti/iac-module-linker.git"
    },
    "keywords": [],
    "author": "Nick Spaghetti",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/NickSpaghetti/iac-module-linker/issues"
    },
    "homepage": "https://github.com/NickSpaghetti/iac-module-linker#readme",
    "dependencies": {
        "@types/semver": "^7.5.4",
        "semver": "^7.8.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^29.4.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/chrome": "^0.3.0",
        "@types/jest": "^29.4.0",
        "@types/node": "^24.19.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^29.4.3",
        "jest-environment-jsdom": "^30.5.2",
        "lint-staged": "^17.1.1",
        "prettier": "^3.9.9",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "ts-jest": "^29.4.13",
        "ts-node": "^10.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1"
    },
    "packageManager": "pnpm@12.8.1"
}
