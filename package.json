{
    "name": "iac-module-linker",
    "version": "1.0.0",
    "description": "Chrome extension that converts Terraform module sources into clickable links to the module definition page.",
    "main": "index.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "webpack",
        "build:bench": "IAC_READABLE=1 webpack",
        "test": "jest",
        "lint": "eslint .",
        "lint:errors": "eslint . --quiet",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit:prod": "yarn npm audit --environment production --no-deprecations",
        "audit:dev": "yarn npm audit --environment development --no-deprecations",
        "prepare": "husky",
        "e2e": "yarn --cwd tests/e2e e2e"
    },
    "resolutions": {
        "@babel/runtime": "^7.26.10"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.tsx": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NickSpaghetti/iac-module-linker.git"
    },
    "keywords": [],
    "author": "Nick Spaghetti",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/NickSpaghetti/iac-module-linker/issues"
    },
    "homepage": "https://github.com/NickSpaghetti/iac-module-linker#readme",
    "dependencies": {
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@mui/icons-material": "^5.11.9",
        "@mui/material": "^5.11.9",
        "@types/semver": "^7.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chrome": "^0.3.0",
        "@types/jest": "^29.4.0",
        "@types/react": "^18.0.25",
        "@types/react-dom": "^18.0.9",
        "copy-webpack-plugin": "^14.0.0",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "html-webpack-plugin": "^5.6.8",
        "husky": "^9.1.7",
        "jest": "^29.4.3",
        "jest-environment-jsdom": "^30.5.2",
        "lint-staged": "^17.1.1",
        "prettier": "^3.9.6",
        "terser-webpack-plugin": "^5.6.1",
        "ts-jest": "^29.4.13",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    },
    "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
